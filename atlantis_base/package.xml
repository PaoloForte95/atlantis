<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>atlantis_base</name>
  <version>0.1.0</version>
  <description>
    Base layer of the Atlantis simulator. Inherits from SimulatorCore
    and provides plugin implementations of move, load, dump, and
    related services that use real path planning.
  </description>

  <maintainer email="you@example.com">Atlantis Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>atlantis_core</depend>
  <depend>atlantis_util</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>visualization_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>navigo</depend>
  <depend>material_handler_msgs</depend>
  <depend>location_msgs</depend>
  <depend>ament_index_cpp</depend>
  <depend>yaml-cpp</depend>
  <depend>atlantis_utils</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <atlantis_core plugin="${prefix}/plugins.xml" />
  </export>
</package>