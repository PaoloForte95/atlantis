<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>atlantis_discrete_event</name>
  <version>0.1.0</version>
  <description>
    Discrete event layer of the Atlantis simulator.
    Provides plugin implementations of move, load, and dump actions
    that update the shared SimulationWorld instantly.
  </description>

  <maintainer email="you@example.com">Atlantis Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>atlantis_core</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>standard_msgs</depend>
  <depend>material_handler_msgs</depend>

  
  <export>
    <build_type>ament_cmake</build_type>
    <atlantis_core plugin="${prefix}/plugins.xml" />
  </export>
</package>