<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>atlantis_core</name>
  <version>0.1.0</version>
  <description>
    Shared base classes and types used by every Atlantis simulator layer.
    Holds the ActionPlugin contract, the SimulationWorld state, and the
    common data types.
  </description>

  <maintainer email="you@example.com">Atlantis Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>pluginlib</depend>
  <depend>std_msgs</depend>
  <depend>location_msgs</depend>
  <depend>atlantis_util</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>